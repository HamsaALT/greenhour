{
  "realm": "greenhour",
  "enabled": true,
  "displayName": "GreenHour",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "da",
    "en"
  ],
  "defaultLocale": "da",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular household user"
      },
      {
        "name": "admin",
        "description": "Can trigger market imports"
      },
      {
        "name": "default-roles-greenhour",
        "description": "Given to everyone who signs up",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ]
        }
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-greenhour"
  },
  "clients": [
    {
      "clientId": "greenhour-web",
      "name": "GreenHour web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
